Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"posB2D", "=", 
   RowBox[{"{", 
    RowBox[{"B1", ",", " ", "B4", ",", "B5", ",", "B8"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"posF2D", "=", 
   RowBox[{"{", 
    RowBox[{"F1", ",", "F4", ",", "F5", ",", "F8"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Graphics3D", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"plotP", "[", 
      RowBox[{
       RowBox[{"rot", ".", "A"}], ",", 
       RowBox[{"rot", ".", 
        RowBox[{"posB2D", "[", 
         RowBox[{"[", "n", "]"}], "]"}]}], ",", 
       RowBox[{"rot", ".", 
        RowBox[{"posF2D", "[", 
         RowBox[{"[", "n", "]"}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", 
       RowBox[{"Length", "[", "posB2D", "]"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<z\>\""}], "}"}]}], ",", 
   
   RowBox[{"Axes", "->", "True"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"R2D", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"B", "-", "A"}], ",", 
    RowBox[{"{", 
     RowBox[{"B", ",", "posB2D"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"posP2D", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"P", "[", 
     RowBox[{"A", ",", 
      RowBox[{"posB2D", "[", 
       RowBox[{"[", "i", "]"}], "]"}], ",", 
      RowBox[{"posF2D", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "posB2D", "]"}]}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"PAB", "=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"rot", ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"R2D", "[", 
             RowBox[{"[", "n", "]"}], "]"}], ".", 
            RowBox[{"{", 
             RowBox[{"a1", ",", "a2", ",", "a3"}], "}"}]}], ")"}]}], ")"}], 
        " ", ".", 
        RowBox[{"{", 
         RowBox[{"kx", ",", "ky", ",", "0"}], "}"}]}]}], "]"}], 
     RowBox[{"rot", ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"posP2D", "[", 
         RowBox[{"[", "n", "]"}], "]"}], ".", 
        RowBox[{"{", 
         RowBox[{"a1", ",", "a2", ",", "a3"}], "}"}]}], ")"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", 
      RowBox[{"Length", "[", "posB2D", "]"}]}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"kx", ",", "ky"}], "}"}], "\[Element]", "Reals"}], ",", 
     RowBox[{"ExpToTrig", "[", "PAB", "]"}]}], "]"}], "//", "MatrixForm"}], "//",
   "Simplify"}]}], "Input",
